{
  "name": "@mermaid-demo/catalog",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsgo -p tsconfig.typecheck.json",
    "dev": "concurrently -n css,sb -c cyan,magenta \"pnpm --filter @mermaid-demo/theme css:watch\" \"storybook dev --no-open -p 6007\"",
    "build": "storybook build",
    "preview-storybook": "http-server storybook-static -p 6007 -c-1",
    "test:storybook": "vitest --config vitest.storybook.config.ts --run"
  },
  "devDependencies": {
    "@internal/shared-config": "workspace:*",
    "@mermaid-demo/mermaid": "workspace:*",
    "@mermaid-demo/theme": "workspace:*",
    "@mermaid-demo/ui": "workspace:*",
    "@storybook/addon-a11y": "^10.2.8",
    "@storybook/addon-docs": "^10.2.8",
    "@storybook/addon-links": "^10.2.8",
    "@storybook/addon-vitest": "^10.2.8",
    "@storybook/react-vite": "^10.2.8",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/browser-playwright": "^4.0.18",
    "concurrently": "^9.2.1",
    "http-server": "^14.1.1",
    "lucide-react": "^0.563.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.2.8",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^4.0.8",
    "vitest-axe": "^1.0.0-pre.3"
  }
}
