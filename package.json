{
  "name": "mermaid-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev:frontend": "pnpm -r --parallel --filter './frontend/**' dev",
    "build": "pnpm build:packages && pnpm build:frontend",
    "build:packages": "pnpm --filter './frontend/packages/**' --if-present build",
    "build:frontend": "pnpm --filter @mermaid-demo/minimap-app build",
    "preview:frontend": "pnpm --filter @mermaid-demo/minimap-app preview",
    "test": "pnpm test:frontend",
    "test:frontend": "pnpm -r --filter './frontend/**' --if-present test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check . --fix --unsafe",
    "format": "biome format . --write",
    "package:check": "taze",
    "package:update": "taze -w --install",

    "clean:build": "find frontend -type d -name dist -exec rm -rf {} +",
    "clean:modules": "find frontend -type d -name node_modules -prune -exec rm -rf {} +",
    "clean:all": "pnpm clean:build && rm -rf node_modules && pnpm clean:modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@internal/shared-config": "workspace:*",
    "taze": "^19.9.2",
    "typescript": "^5.9.3"
  }
}
